# PostgreSQL connection (same values you use in Navicat)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lao_typing_app

# Better Auth: signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public address of the site (http://localhost:3000 while developing)
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

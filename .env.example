# PostgreSQL connection (same values you use in Navicat)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/lao_typing_app

# Better Auth: signs session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Public address of the site (http://localhost:3000 while developing).
# Set this to the public HTTPS address when deploying to a VPS.
BETTER_AUTH_URL=http://localhost:3000

# Optional: "Continue with Google". Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP for forgot-password emails (use port 465 for implicit TLS, otherwise 587 for STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Premium (50,000 LAK / month): admins approve payment slips at /admin/payments
# Comma-separated emails of the accounts that are admins
ADMIN_EMAILS=khamher807@gmail.com
ADMIN_PASSWORDS=replace-with-at-least-8-random-characters
# Where members transfer the money (shown on /premium; leave a line empty to hide it)
PAYMENT_BANK=BCEL
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
# Your bank QR image, e.g. put it at public/assets/payment/qr.png and set /assets/payment/qr.png
PAYMENT_QR_IMAGE=

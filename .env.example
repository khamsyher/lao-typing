# Random string, at least 32 chars:  npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public URL of the site
BETTER_AUTH_URL=http://localhost:3000

# Local SQLite file by default. In production use Turso: libsql://<db>.turso.io + auth token
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string, at least 32 chars:  npx @better-auth/cli secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=
# Public URL of the site
BETTER_AUTH_URL=http://localhost:3000

# PostgreSQL connection string
#   local:  postgres://postgres:<password>@localhost:5432/lao_typing_app
#   hosted (Neon, Supabase, Railway, …): add ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lao_typing_app
# Optional: max connections per server instance (keep small on serverless)
DATABASE_POOL_MAX=10

# Optional: enables "Continue with Google"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
